{
  "expo": {
    "name": "Põe na Dolorosa",
    "slug": "poe-na-dolorosa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F14",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.pixmedeve.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F14"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pixmedeve.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C6FFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Põe na Dolorosa usa suas fotos para definir a foto do seu perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4f423edb-11eb-4d40-af8c-2036c4c77e45"
      }
    }
  }
}
